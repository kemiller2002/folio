{
  "name": "@echelon-foundry/print-components",
  "version": "0.4.2",
  "private": false,
  "description": "Folio: standards-first web components and CSS primitives for professional HTML print documents.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/components/register.d.ts",
      "import": "./src/components/register.js",
      "default": "./src/components/register.js"
    },
    "./runtime": {
      "types": "./src/runtime.d.ts",
      "import": "./src/runtime.js",
      "default": "./src/runtime.js"
    },
    "./print.css": "./src/styles/print.css",
    "./machine-operability.json": "./contracts/machine-operability-catalog.json",
    "./forma-icons": "./tools/forma-icons.mjs",
    "./forma-icon-print": "./tools/forma-icon-print.mjs"
  },
  "files": [
    "src",
    "README.md",
    "contracts",
    "tools/forma-icons.mjs",
    "tools/forma-icon-print.mjs"
  ],
  "sideEffects": [
    "./src/components/register.js",
    "./src/runtime.js",
    "./src/styles/print.css"
  ],
  "scripts": {
    "test": "npm run runtime:check && node --test tests/runtime-version.test.mjs && node tests/run-primitive-component-tests.mjs && npm run test:ui-conformance:rules && node tests/machine-operability-audit.test.mjs && npm run machine:audit:check && node tests/run-machine-operability-tests.mjs && node tests/run-tutela-security-record-tests.mjs && node tests/run-print-experiments.mjs && node tests/run-report-fixture-tests.mjs && node tests/run-profile-fixture-tests.mjs && node tests/run-journal-fixture-tests.mjs && node tests/run-diagram-projection-tests.mjs && npm run test:forma-icons && npm run test:forma-icon-print",
    "test:print": "node tests/run-print-experiments.mjs",
    "site:build": "npm run runtime:build && node tools/build-site.mjs",
    "site:test": "node --test tests/site-build.test.mjs",
    "site:test:browser": "node tests/run-site-browser-tests.mjs",
    "site:check": "npm run site:build && npm run site:test",
    "test:ui-conformance:rules": "node --test tests/ui-conformance-rules.test.mjs tests/ui-conformance-evidence.test.mjs",
    "ui:conformance": "npm run site:build && npm run test:ui-conformance:rules && node tests/run-ui-conformance.mjs",
    "ui:conformance:print": "npm run site:build && node tests/run-ui-conformance.mjs --scope=print",
    "ui:conformance:site": "npm run site:build && node tests/run-ui-conformance.mjs --scope=site",
    "pack:verify": "npm pack --dry-run",
    "test:report": "node tests/run-report-fixture-tests.mjs",
    "test:tutela": "node tests/run-tutela-security-record-tests.mjs",
    "test:profiles": "node tests/run-profile-fixture-tests.mjs",
    "test:diagram": "node tests/run-diagram-projection-tests.mjs",
    "test:journal": "node tests/run-journal-fixture-tests.mjs",
    "experiment:journal-enhanced": "node tests/run-journal-enhanced-experiment.mjs",
    "test:machine": "node tests/run-machine-operability-tests.mjs",
    "machine:audit": "npm run site:build && node tools/machine-operability-audit.mjs --write",
    "machine:audit:check": "npm run site:build && node tools/machine-operability-audit.mjs --check --strict",
    "test:machine:audit": "node --test tests/machine-operability-audit.test.mjs",
    "test:forma-icons": "node tests/run-forma-icon-tests.mjs",
    "test:forma-icon-print": "node tests/run-forma-icon-print-tests.mjs",
    "runtime:build": "node tools/build-runtime-version.mjs",
    "runtime:check": "node tools/build-runtime-version.mjs --check",
    "prepack": "npm run runtime:check"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "playwright": "1.63.0"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kemiller2002/folio.git"
  },
  "types": "./src/components/register.d.ts",
  "license": "PolyForm-Noncommercial-1.0.0"
}
